        "atcCodes": [
          "N04AA01"
        ],
        "drugClass": [
          "抗胆碱药"
        ],
        "indications": [
          "帕金森综合征的辅助治疗",
          "药物引起的锥体外系症状"
        ],
        "contraindications": [
          "对本品或辅料过敏",
          "窄角型青光眼"
        ],
        "majorWarnings": [
          "可引起口干、视物模糊、便秘、尿潴留及认知障碍。",
          "减少出汗可导致高热；避免突然停药。",
          "可能加重迟发性运动障碍。"
        ],
        "majorInteractions": [
          "酒精及其他中枢抑制药可增加镇静。",
          "与单胺氧化酶抑制剂或三环类抗抑郁药合用，抗胆碱作用可能增强。"
        ],
        "monitoring": [
          "眼压、视力变化",
          "排尿、排便、出汗和体温",
          "意识、记忆及不自主运动"
        ],
